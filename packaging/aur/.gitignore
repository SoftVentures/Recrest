# makepkg working output — never committed, and never pushed to the AUR remotes.
src/
pkg/
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.tar.gz
recrest-git/recrest-git/
# Both source packages use a git source, so makepkg clones into <pkgdir>/<pkgname>/.
recrest/recrest/
# recrest-bin downloads its sources instead of cloning them.
recrest-bin/*.deb
recrest-bin/LICENSE-*
