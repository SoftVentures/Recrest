# Maintainer: Manuel Haucke <manuel.haucke12@gmail.com>

pkgname=recrest
pkgver=0.11.0
pkgrel=1
pkgdesc="Lightweight native developer dashboard for local git repos, pull requests, and CI checks"
arch=('x86_64' 'aarch64')
url="https://github.com/SoftVentures/Recrest"
license=('MIT')
# `dbus`: `tao` (Tauri's windowing layer) links libdbus-1 via libdbus-sys on
# every Linux build, so this is needed regardless of how tokens are stored.
# Until now it was only satisfied transitively via the webkit2gtk-4.1 chain.
# `desktop-file-utils`: recrest.desktop declares
# `MimeType=x-scheme-handler/recrest`, and pacman only runs its
# `update-desktop-database` hook when this package is installed. Without it the
# `recrest://` scheme is never registered and deep links silently do nothing.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'hicolor-icon-theme'
         'dbus' 'desktop-file-utils')
# `nodejs>=22` is a floor, not the upstream contract: the root package.json pins
# `engines.node` to an exact patch version and `prepare()` passes
# `--ignore-engines` to get past it (see the note there). That means a future
# Node in [extra] can only surface as a build failure on the user's machine —
# upstream CI pins its own version and stays green. Bump the floor here when
# upstream raises its major.
makedepends=('rust' 'nodejs>=22' 'yarn' 'git' 'pkgconf')
provides=("$pkgname=$pkgver")
conflicts=("$pkgname-git" "$pkgname-bin")
# The Rust release profile already sets `lto = true` and `strip = true`; makepkg's
# own LTO flags only apply to the C sources compiled by cc-rs (vendored libgit2 /
# openssl) and have caused link failures there, so opt out.
options=('!lto')
# A git source pinned to the tag, NOT `archive/refs/tags/v$pkgver.tar.gz`.
# GitHub generates those tarballs on demand and does not guarantee them to be
# byte-stable — when its gzip implementation changed in 2023 every checksummed
# auto-tarball in the AUR broke at once, without any upstream release. A tag is
# an immutable git ref, so `SKIP` here is not a weaker guarantee than a checksum
# over a file that upstream cannot keep stable. Upstream publishes installers as
# release assets but no source tarball, so there is nothing stable to checksum.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"

  # `--ignore-engines` is required: .yarnrc sets `engine-strict true` and the root
  # package.json pins `engines.node` to the exact version upstream develops
  # against, which will not match the `nodejs` package in [extra].
  #
  # `--ignore-scripts` skips the repo's postinstall hooks (`check-node.cjs`, which
  # hard-fails on that same version mismatch, and `husky`, which would install git
  # hooks into this throwaway clone). The one postinstall step that actually
  # matters — building @recrest/shared — is run explicitly below, because
  # app/tsconfig.app.json references shared/dist as a TS project.
  yarn install --frozen-lockfile --ignore-engines --ignore-scripts --non-interactive
  yarn workspace @recrest/shared build
}

build() {
  cd "$pkgname"

  # `--no-bundle` stops the Tauri CLI after linking the executable. We do not want
  # its .deb/.rpm bundles (see `bundle.targets` in tauri.conf.json), and
  # bundling would additionally demand a TAURI_SIGNING_PRIVATE_KEY because
  # `createUpdaterArtifacts` is enabled upstream.
  yarn workspace @recrest/app tauri build --no-bundle
}

package() {
  cd "$pkgname"

  # [[bin]] name in Cargo.toml is capitalised ("Recrest") for the macOS Dock label,
  # so that is the file cargo emits; on Linux the installed command is lowercase.
  # recrest-launcher.sh does not hardcode either spelling — it probes
  # `$APPDIR/usr/bin`, its own directory, `/usr/bin` and `/usr/local/bin` for both
  # `Recrest` and `recrest` and execs the first hit — because the upstream
  # .deb/.rpm install the capitalised name while we install the
  # lowercase one. Renaming the binary here therefore stays purely our choice,
  # and upstream's `mainBinaryName` is deliberately NOT set: it would rename
  # `target/release/Recrest` for every `tauri build` and break the install below.
  install -Dm755 "app/src-tauri/target/release/Recrest" "$pkgdir/usr/bin/recrest"
  install -Dm755 "app/src-tauri/resources/recrest-launcher.sh" "$pkgdir/usr/bin/recrest-launcher"
  install -Dm644 "app/src-tauri/resources/recrest.desktop" "$pkgdir/usr/share/applications/recrest.desktop"

  local _size
  for _size in 32 64 128 256 512; do
    install -Dm644 "app/src-tauri/icons/linux/${_size}x${_size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/recrest.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
