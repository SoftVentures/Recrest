{
  "name": "@recrest/tests",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ts": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:landing": "playwright test --project=landing-desktop --project=landing-mobile",
    "test:e2e:app": "playwright test --project=app-desktop --project=app-firefox --project=app-webkit",
    "test:e2e:visual": "playwright test --project=app-desktop src/e2e/app/99-visual-tour.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:tauri": "wdio run wdio.conf.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@recrest/shared": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@wdio/cli": "^9.31.1",
    "@wdio/local-runner": "^9.31.1",
    "@wdio/mocha-framework": "^9.31.1",
    "@wdio/spec-reporter": "^9.31.1",
    "eslint": "^9.39.4",
    "express": "^5.0.0",
    "playwright": "^1.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "webdriverio": "^9.4.0"
  }
}
