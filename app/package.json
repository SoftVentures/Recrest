{
  "name": "@recrest/app",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --base /Recrest/demo/ --outDir ../landingpage/dist/demo --emptyOutDir",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "gen:installer-assets": "node src-tauri/installer-assets/generate.mjs",
    "gen:icon-variants": "node src-tauri/scripts/gen-icon-variants.mjs",
    "gen:prod-icons": "node src-tauri/scripts/gen-icon-variants.mjs --prod",
    "gen:dev-icons": "node src-tauri/scripts/gen-icon-variants.mjs --dev",
    "preformat": "node src/scripts/fix-imports.js",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,md,css}'",
    "format:imports": "node src/scripts/fix-imports.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ts": "tsc -b",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dep-graph": "madge --image dependency-graph.svg --extensions ts,tsx --ts-config tsconfig.app.json src/",
    "dep-graph:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src/",
    "dep-graph:json": "madge --json --extensions ts,tsx --ts-config tsconfig.app.json src/ > dependency-graph.json",
    "dep-graph:dot": "madge --dot --extensions ts,tsx --ts-config tsconfig.app.json src/ > dependency-graph.dot"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/opendyslexic": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@recrest/shared": "*",
    "@reduxjs/toolkit": "^2.2.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/dompurify": "^3.2.0",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "countries-and-timezones": "^3.7.2",
    "device-type-detection": "^2.1.3",
    "dompurify": "^3.4.7",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.17.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.17.0",
    "sonner": "^2.0.7",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.8.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jimp": "^1.6.0",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "sass": "^1.83.0",
    "storybook": "^10.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.8"
  }
}
