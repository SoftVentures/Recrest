{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recrest",
  "version": "0.13.0",
  "identifier": "eu.softventures.recrest",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Recrest",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "acceptFirstMouse": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://gitlab.com https://api.bitbucket.org; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "recrest"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQjM4QkRDQUNBQzc3N0IKUldSN2Q2eXMzSXV6UzA5dVFUZDhaWWl3UGR4TTh6YzFMWEltcXdPbDlsMllLL3dUcXlMMFo1NVoK",
      "endpoints": [
        "https://github.com/SoftVentures/Recrest/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/linux/32x32.png",
      "icons/linux/64x64.png",
      "icons/linux/128x128.png",
      "icons/linux/256x256.png",
      "icons/linux/512x512.png",
      "icons/mac/icon.icns",
      "icons/windows/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight developer dashboard",
    "longDescription": "Recrest surfaces local git repositories, their working-tree status, open pull requests, and CI checks in one native desktop app.",
    "copyright": "Copyright (c) 2026 SoftVentures",
    "publisher": "SoftVentures",
    "homepage": "https://github.com/SoftVentures/Recrest",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "German"
        ],
        "installerIcon": "icons/windows/icon.ico",
        "headerImage": "installer-assets/build/nsis-header.bmp",
        "sidebarImage": "installer-assets/build/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer-assets/build/wix-banner.bmp",
        "dialogImagePath": "installer-assets/build/wix-dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "background": "installer-assets/build/dmg-background.png"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "desktop-file-utils",
          "librsvg2-2",
          "dbus",
          "hicolor-icon-theme"
        ],
        "section": "devel",
        "desktopTemplate": "resources/recrest.desktop",
        "files": {
          "/usr/bin/recrest-launcher": "resources/recrest-launcher.sh",
          "/usr/share/metainfo/com.soft_ventures.Recrest.metainfo.xml": "resources/com.soft_ventures.Recrest.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/recrest.png": "icons/linux/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/recrest.png": "icons/linux/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/recrest.png": "icons/linux/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/recrest.png": "icons/linux/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/recrest.png": "icons/linux/512x512.png"
        }
      },
      "rpm": {
        "depends": [
          "desktop-file-utils",
          "hicolor-icon-theme"
        ],
        "desktopTemplate": "resources/recrest.desktop",
        "files": {
          "/usr/bin/recrest-launcher": "resources/recrest-launcher.sh",
          "/usr/share/metainfo/com.soft_ventures.Recrest.metainfo.xml": "resources/com.soft_ventures.Recrest.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/recrest.png": "icons/linux/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/recrest.png": "icons/linux/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/recrest.png": "icons/linux/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/recrest.png": "icons/linux/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/recrest.png": "icons/linux/512x512.png"
        }
      }
    },
    "createUpdaterArtifacts": true
  }
}
